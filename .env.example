# ==============================================================================
# CineExplorer Environment Configuration
# ==============================================================================
# Configure these variables in your Vercel Project Settings:
# Settings -> Environment Variables -> Add New
# ==============================================================================

# TMDB (The Movie Database) - Powers real-time live releases & trending movies
# Get your free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here

# OMDb (Open Movie Database) - Fallback for global film catalog search
# Get your free key at: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=trilogy

# Production Site URL (Automatically set on Vercel, or set your custom domain)
NEXT_PUBLIC_SITE_URL=https://your-cineexplorer-app.vercel.app

# Optional AI / Analytics Services
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_ADSENSE_ID=
